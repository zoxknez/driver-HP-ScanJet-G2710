; HP ScanJet G2710 - WIA 2.0 driver package
;
; Transport je Microsoftov in-box usbscan.sys, povucen preko sti.inf. Ne
; isporucujemo nijedan .sys - ceo nas kod je user-mode.
;
; Vidi docs/PROTOCOL-RTS8822.md za razlog izbora usbscan.sys umesto WinUSB.
;
; Copyright (C) 2026 G2710 project
; GPL-2.0-or-later. Izvedeno iz hp3900 (Jonathan Bravo Lopez) - NOTICE-hp3900.md

[Version]
Signature   = "$WINDOWS NT$"
Class       = Image
ClassGuid   = {6BDD1FC6-810F-11D0-BEC7-08002BE2092F}
Provider    = %ProviderName%
CatalogFile = g2710.cat
; Broj MORA odgovarati korenskom VERSION fajlu; drzi ga
; DriverVersionMatchesTheVersionFile u tests/unit/wia_events_test.cpp.
;
; Ovo je broj koji Device Manager prikazuje i koji pnputil vraca - dakle
; jedini broj koji prijatelj moze da procita i posalje nazad. Dok je ovde
; stajalo 1.0.0.0 a paket bio 0.1.0, taj odgovor je bio bezvredan.
;
; I datum je vazan: PnP po njemu bira izmedju dva drajvera za isti uredjaj.
DriverVer   = 08/20/2026,0.1.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13     ; DriverStore - zahtev za universal driver package

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
G2710.Wia.dll = 1

[Manufacturer]
%ProviderName% = G2710.Models, NTamd64.10.0...19041

; Windows 10 2004+ i Windows 11, x64.
[G2710.Models.NTamd64.10.0...19041]
%G2710.DeviceDesc% = G2710.Install, USB\VID_03F0&PID_2805

; ---------------------------------------------------------------- install ----

[G2710.Install]
Include   = sti.inf
Needs     = STI.USBSection
CopyFiles = G2710.CopyFiles
AddReg    = G2710.AddReg, G2710.DeviceData, G2710.Events

[G2710.Install.Services]
Include = sti.inf
Needs   = STI.USBSection.Services

[G2710.Install.HW]
Include = sti.inf
Needs   = STI.USBSection.HW

[G2710.CopyFiles]
G2710.Wia.dll

; ------------------------------------------------------------- registracija ---
; COM registracija ide kroz INF, ne kroz DllRegisterServer - PnP driver paketi
; ne smeju zavisiti od self-registration.

[G2710.AddReg]
HKCR,CLSID\%G2710.CLSID%,,,%G2710.WiaFriendlyName%
HKCR,CLSID\%G2710.CLSID%\InprocServer32,,,%13%\G2710.Wia.dll
HKCR,CLSID\%G2710.CLSID%\InprocServer32,ThreadingModel,,"Both"

; -------------------------------------------------------------- device data ---
; Vrednosti koje STI/WIA servis cita da bi znao kako da opsluzi uredjaj.

[G2710.DeviceData]
HKR,,USDClass,,%G2710.CLSID%
HKR,,Vendor,,%ProviderName%
HKR,,Model,,%G2710.Model%
HKR,,DeviceType,0x00010001,2            ; StiDeviceTypeScanner
HKR,,Capabilities,0x00010001,0x33       ; generate events, notify, polling
HKR,,ISISDriver,,""
HKR,,TwainDS,,""
HKR,,Server,,"local"
HKR,,UI DLL,,""
HKR,,ICMProfiles,,"sRGB Color Space Profile.icm"

; ------------------------------------------------------------------ eventi ----
; Tri fizicka dugmeta. Maske 0x01 / 0x02 / 0x04 dolaze iz hp3800_buttons
; (cfg_buttons_get); mapiranje maska -> dugme se potvrdjuje u H10.
; Dovod je interrupt pipe preko IOCTL_WAIT_ON_DEVICE_EVENT.
;
; PODRAZUMEVANA vrednost podkljuca je GUID DOGADJAJA, ne prikazno ime.
; Ime ide u Name, opis u Desc. Sa imenom na mestu GUID-a STI servis ne bi
; umeo da poveze pritisak dugmeta sa registrovanim rukovaocem, a greska se
; vidi tek kada neko pritisne dugme - dakle u H10, na daljinu.
;
; GUID-ovi su WIA_EVENT_SCAN_IMAGE / _SCAN_PRINT_IMAGE / _SCAN_OCR_IMAGE
; iz wiadef.h. native/wia/G2710Usd.cpp mora vracati BAS ove vrednosti;
; tests/unit/wia_events_test.cpp drzi tu saglasnost.

; Ikone se pisu NEGATIVNIM brojem.
;
; Za Windows je `fajl,N` sa nenegativnim N REDNI BROJ ikone, a ne njen ID
; resursa; ID se trazi negativnim brojem. Ranije je ovde stajalo ",101" -
; drajver koji ima tri ikone nema ikonu sa rednim brojem 101, pa je Windows u
; kartici "Dogadjaji" crtao prazno mesto.
;
; Izmereno ExtractIconEx-om na sastavljenom DLL-u: -101/-102/-103 daju ikone,
; 101 ne daje nista. Brojevi odgovaraju resursima u native/wia/G2710Wia.rc.
[G2710.Events]
HKR,Events\Scan,,,%G2710.ScanEventGuid%
HKR,Events\Scan,Name,,"Scan"
HKR,Events\Scan,Desc,,%G2710.ScanButton%
HKR,Events\Scan,Icon,,"%13%\G2710.Wia.dll,-101"

HKR,Events\Copy,,,%G2710.CopyEventGuid%
HKR,Events\Copy,Name,,"Copy"
HKR,Events\Copy,Desc,,%G2710.CopyButton%
HKR,Events\Copy,Icon,,"%13%\G2710.Wia.dll,-102"

HKR,Events\Pdf,,,%G2710.PdfEventGuid%
HKR,Events\Pdf,Name,,"Pdf"
HKR,Events\Pdf,Desc,,%G2710.PdfButton%
HKR,Events\Pdf,Icon,,"%13%\G2710.Wia.dll,-103"

; ------------------------------------------------------------------ stringovi -

[Strings]
ProviderName            = "G2710 Project"
DiskName                = "HP ScanJet G2710 Driver Disk"
G2710.DeviceDesc        = "HP ScanJet G2710"
G2710.Model             = "ScanJet G2710"
G2710.WiaFriendlyName   = "HP ScanJet G2710 WIA Driver"
G2710.ScanButton        = "Scan"
G2710.CopyButton        = "Copy"
G2710.PdfButton         = "PDF"

; WIA_EVENT_SCAN_IMAGE, _SCAN_PRINT_IMAGE, _SCAN_OCR_IMAGE (wiadef.h).
G2710.ScanEventGuid     = "{A6C5A715-8C6E-11D2-977A-0000F87A926F}"
G2710.CopyEventGuid     = "{B441F425-8C6E-11D2-977A-0000F87A926F}"
G2710.PdfEventGuid      = "{9D095B89-37D6-4877-AFED-62A297DC6DBE}"

; MORA biti identican G2710_WIA_CLSID_STRING u native/wia/G2710Wia.h.
G2710.CLSID             = "{2C4E8A1D-7F63-4B95-9E12-3A6D5C8B0417}"
