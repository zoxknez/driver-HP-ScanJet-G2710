<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="HP ScanJet G2710" Manufacturer="G2710 Project" Version="$(var.ProductVersion)" UpgradeCode="A1B2C3D4-94E2-4A8A-928A-1234567890AB" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of HP ScanJet G2710 is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- Paket je potpisan sopstvenim sertifikatom. Onaj ko ga zatekne u spisku
         programa mora moci da sazna odakle je dosao, bez pitanja ikoga. -->
    <Property Id="ARPURLINFOABOUT"
              Value="https://github.com/zoxknez/driver-HP-ScanJet-G2710" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="HP ScanJet G2710">
        <Component Id="ApplicationFiles" Guid="BCA7D65D-5D39-4A46-9E77-B031A8C4E714">
          <File Source="$(var.AppDir)\G2710.App.exe" KeyPath="yes" />
          <File Source="$(var.AppDir)\G2710.App.dll" />
          <File Source="$(var.AppDir)\G2710.App.deps.json" />
          <File Source="$(var.AppDir)\G2710.App.runtimeconfig.json" />
          <File Source="$(var.AppDir)\G2710.Interop.dll" />
          <File Source="$(var.AppDir)\G2710.Native.dll" />
          <File Source="$(var.AppDir)\G2710.Localization.dll" />
        </Component>
        <!-- Engleski je ugradjen u samu biblioteku; srpski je satelit i mora
             stici kao zaseban fajl u svom folderu. Da izostane, program bi i
             dalje radio - govorio bi engleski. Zato je engleski neutralni
             resurs, a ne satelit. -->
        <Directory Id="SRFOLDER" Name="sr">
          <Component Id="SerbianResources" Guid="4F3C1D6A-2B7E-4E51-9C08-5A6D2E9B3C41">
            <File Source="$(var.AppDir)\sr\G2710.Localization.resources.dll" KeyPath="yes" />
          </Component>
        </Directory>
        <!-- Izbor jezika iz dijaloga. Language.cs cita bas ovu vrednost, i
             cita je pre nego sto pogleda jezik Windows-a. -->
        <Component Id="LanguageChoice" Guid="9E1B7A24-38D6-4F0C-BC55-7A2E4D8F6013">
          <RegistryValue Root="HKLM" Key="SOFTWARE\G2710" Name="Language"
                         Type="string" Value="[G2710LANGUAGE]" KeyPath="yes" />
          <!-- Vrednost MSI uklanja sam; prazan KLJUC iza nje ne mora. Ostavljen
               kljuc je jedini trag koji bi preziveo deinstalaciju, a pravilo
               ovog projekta je da posle uklanjanja ne ostane nista - mereno, ne
               pretpostavljeno. Ovim prestaje da zavisi od implicitnog
               ponasanja. -->
          <RemoveRegistryKey Root="HKLM" Key="SOFTWARE\G2710"
                             Action="removeOnUninstall" />
        </Component>
        <Directory Id="DRIVERFOLDER" Name="driver">
          <Component Id="DriverPackage" Guid="7D720503-F9D4-4543-96D7-5B3C868A3110">
            <File Source="$(var.DriverDir)\g2710.inf" KeyPath="yes" />
            <File Source="$(var.DriverDir)\G2710.Wia.dll" />
            <File Source="$(var.DriverDir)\g2710.cat" />
            <?if $(var.IncludeDevCertificate) = 1 ?>
            <File Source="$(var.DriverDir)\g2710-dev.cer" />
            <?endif?>
            <File Id="DriverInstallScript" Source="$(var.DriverDir)\install.ps1" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <!-- DSM trazi izvore ovde; Program Files nije TWAIN discovery lokacija. -->
    <StandardDirectory Id="WindowsFolder">
      <Directory Id="TWAIN64FOLDER" Name="twain_64">
        <Component Id="Twain64" Guid="23A151A5-B2EC-4A9C-92CD-D7840D0B272D">
          <!-- Open-source DSM ucitava samo *.ds iz twain_64. -->
          <File Source="$(var.Twain64Dir)\G2710.Twain.dll" Name="G2710.Twain.ds" KeyPath="yes" />
        </Component>
      </Directory>
      <Directory Id="TWAIN86FOLDER" Name="twain_32">
        <Component Id="Twain86" Guid="C9547268-C8D5-410F-A2ED-3A8DADAE5D94">
          <!-- Isto pravilo vazi za 32-bit DSM i twain_32. -->
          <File Source="$(var.Twain86Dir)\G2710.Twain.dll" Name="G2710.Twain.ds" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="ProductFeature" Title="HP ScanJet G2710" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="SerbianResources" />
      <ComponentRef Id="LanguageChoice" />
      <ComponentRef Id="DriverPackage" />
      <ComponentRef Id="Twain64" />
      <ComponentRef Id="Twain86" />
    </Feature>
    <!-- Minimalni WixUI: prvo izbor jezika, pa licenca (GPL-2.0 se mora
         pokazati). Jezik ide prvi jer je to jedino pitanje koje MI postavljamo;
         sve posle njega je standardni tok. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <!-- Bez ova dva Wix stavlja svoj podrazumevani crtez - crveni znak zabrane
         na prvom ekranu instalacije drajvera. Slike nastaju iz skripte, u
         istim bojama kao program. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.InstallerArt)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.InstallerArt)\dialog.bmp" />
    <!-- Dijalog stoji u UI sekvenci PRE licence, a ne na dugmetu "Install".
         Mereno na sastavljenom MSI-ju: Install vec nosi EndDialog na redu 2, a
         dodati NewDialog dobija veci red - dijalog se nikada ne bi pojavio, i
         to se ne bi videlo dok neko ne pokrene instalaciju. -->
    <InstallUISequence>
      <Show Dialog="G2710LanguageDlg" Sequence="1294" Condition="NOT Installed" />
    </InstallUISequence>

    <!-- MSI je per-machine, pa se ove akcije izvrsavaju kao LocalSystem.
         Skript radi samo sa NASIM INF-om i sertifikatom po otisku; ne dira
         Secure Boot, TESTSIGNING niti tudje drajvere. -->
    <CustomAction Id="InstallDriverPackage" Directory="SystemFolder"
                  ExeCommand="WindowsPowerShell\v1.0\powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[#DriverInstallScript]&quot; -Quiet"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RemoveDriverPackage" Directory="SystemFolder"
                  ExeCommand="WindowsPowerShell\v1.0\powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[#DriverInstallScript]&quot; -Uninstall -Quiet"
                  Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="InstallDriverPackage" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RemoveDriverPackage" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
