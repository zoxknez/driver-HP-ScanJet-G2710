<Window x:Class="G2710.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HP ScanJet G2710" Height="620" Width="900" MinHeight="540" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="{StaticResource SurfaceSunken}">
  <Grid Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="HP ScanJet G2710" Style="{StaticResource TitleText}" />
      <TextBlock Text="Skeniranje i dijagnostika" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
    </StackPanel>
    <Border Grid.Row="1" Margin="0,24,0,24" Padding="20" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource HeadingText}" />
        <TextBlock Grid.Row="1" Text="{Binding StatusDetail}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,20" />
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Izvor" Style="{StaticResource SmallText}"/><ComboBox SelectedValue="{Binding Transport}" SelectedValuePath="Tag" Margin="0,4,12,0"><ComboBoxItem Tag="UsbScan" Content="Skener (USB)"/><ComboBoxItem Tag="Simulator" Content="Simulator"/></ComboBox></StackPanel>
          <!-- Spisak dolazi iz jezgra, ne odavde. Otkucane stavke se razidju sa
               drajverom prvi put kada neka rezolucija promeni status. -->
          <StackPanel Grid.Column="1">
            <TextBlock Text="Rezolucija" Style="{StaticResource SmallText}"/>
            <ComboBox ItemsSource="{Binding Resolutions}"
                      SelectedItem="{Binding SelectedResolution}"
                      DisplayMemberPath="Label"
                      Margin="0,4,12,0" />
          </StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Režim" Style="{StaticResource SmallText}"/><ComboBox SelectedValue="{Binding ColorMode}" SelectedValuePath="Tag" Margin="0,4,0,0"><ComboBoxItem Tag="Color" Content="U boji"/><ComboBoxItem Tag="Gray" Content="Sivo"/><ComboBoxItem Tag="Lineart" Content="Crno-belo"/></ComboBox></StackPanel>
        </Grid>
        <!-- Ono sto se ne sme precutati: izabrana vrednost nije hardverski
             potvrdjena. Vidljivo je samo kada zaista ima sta da se kaze. -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" Margin="0,64,0,0"
                Padding="10,6" CornerRadius="4"
                Background="{StaticResource SurfaceSunken}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                >
          <!-- DataTrigger umesto konvertera: aplikacija time ne mora da deli
               ni jednu klasu sa wizardom, a ponasanje je isto. -->
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasResolutionCaveat}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding SelectedResolutionCaveat}"
                     Style="{StaticResource SmallText}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
          <TextBlock Text="Crop (preview px):" Style="{StaticResource SmallText}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Width="55" Text="{Binding CropLeft, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" ToolTip="Levo" />
          <TextBox Width="55" Text="{Binding CropTop, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" ToolTip="Gore" />
          <TextBox Width="55" Text="{Binding CropWidth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" ToolTip="Širina" />
          <TextBox Width="55" Text="{Binding CropHeight, UpdateSourceTrigger=PropertyChanged}" ToolTip="Visina" />
          <TextBlock Text="(nule = cela površina)" Style="{StaticResource SmallText}" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>
        <Border Grid.Row="4" Margin="0,24,0,0" Height="170" Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <Grid x:Name="PreviewSurface" Background="Transparent"
                MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown"
                MouseMove="PreviewSurface_MouseMove"
                MouseLeftButtonUp="PreviewSurface_MouseLeftButtonUp"
                ToolTip="Prevucite mišem preko prikaza da izaberete oblast za konačno skeniranje.">
            <Image x:Name="PreviewControl" Source="{Binding PreviewImage}" Stretch="Uniform" />
            <Canvas x:Name="CropCanvas" Background="Transparent">
              <Rectangle x:Name="CropRectangle" Visibility="Collapsed" Stroke="{StaticResource Accent}" StrokeThickness="2" Fill="#334AA3DF" />
            </Canvas>
          </Grid>
        </Border>
        <TextBlock Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   Margin="0,0,0,6" Style="{StaticResource SmallText}"
                   Text="{Binding PagesSummary}" />
        <TextBox Grid.Row="5" Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" />
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Sačuvaj trag" Style="{StaticResource SecondaryButton}" Command="{Binding WriteTraceCommand}" Margin="0,0,12,0" />
      <Button Content="Preview" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewCommand}" IsEnabled="{Binding CanScan}" Margin="0,0,12,0" />
      <ComboBox Width="92" SelectedValue="{Binding ExportFormat}" SelectedValuePath="Tag" Margin="0,0,8,0">
        <ComboBoxItem Tag="Png" Content="PNG"/><ComboBoxItem Tag="Jpeg" Content="JPEG"/><ComboBoxItem Tag="Tiff8" Content="TIFF 8"/><ComboBoxItem Tag="Tiff16" Content="TIFF 16"/><ComboBoxItem Tag="Pdf" Content="PDF"/>
      </ComboBox>
      <Button Content="Dodaj stranicu" Style="{StaticResource SecondaryButton}"
              Command="{Binding AddPageCommand}" IsEnabled="{Binding HasImage}"
              ToolTip="Odloži trenutnu sliku kao stranicu; izvoz u PDF spaja sve odložene."
              Margin="0,0,8,0" />
      <Button Content="Obriši stranice" Style="{StaticResource SecondaryButton}"
              Command="{Binding ClearPagesCommand}" IsEnabled="{Binding HasPages}"
              Margin="0,0,12,0" />
      <Button Content="Izvezi" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}" IsEnabled="{Binding HasImage}" Margin="0,0,12,0" />
      <Button Content="Prekini" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" IsEnabled="{Binding IsScanning}" Margin="0,0,12,0" />
      <Button Content="Skeniraj" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" Margin="0,0,12,0" />
      <Button Content="Proveri vezu" Style="{StaticResource PrimaryButton}" Command="{Binding CheckCommand}" />
    </StackPanel>
  </Grid>
</Window>
