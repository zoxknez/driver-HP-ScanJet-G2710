<UserControl x:Class="G2710.Qualification.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:G2710.Localization;assembly=G2710.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PageMargin}">
        <!--
            Dve kolone: objasnjenje i podesavanja. Prozor je sirok, pa jedna
            kolona teksta ostavlja pola ekrana praznog.
        -->
        <Grid MaxWidth="980" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- ===== sta ce se desiti ===== -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Wiz_Welcome_What}"
                                   Style="{StaticResource HeadingText}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="1."
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       Margin="0,0,10,0" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                       Style="{StaticResource BodyText}"
                                       Text="{loc:Str Wiz_Welcome_Step1}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="2."
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       Margin="0,0,10,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                       Style="{StaticResource BodyText}"
                                       Text="{loc:Str Wiz_Welcome_Step2}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="3."
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       Margin="0,0,10,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                                       Style="{StaticResource BodyText}"
                                       Text="{loc:Str Wiz_Welcome_Step3}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="4."
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       Margin="0,0,10,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Style="{StaticResource BodyText}"
                                       Text="{loc:Str Wiz_Welcome_Step4}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Background="{StaticResource SurfaceSunken}">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Wiz_Welcome_Before}"
                                   Style="{StaticResource HeadingText}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyText}"
                                   Text="{loc:Str Wiz_Welcome_Before_1}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}"
                                   Text="{loc:Str Wiz_Welcome_Before_2}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== podesavanja ===== -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Wiz_Welcome_Settings}" Style="{StaticResource HeadingText}" />

                        <CheckBox Margin="0,14,0,0" IsChecked="{Binding UseSimulator}"
                                  FontFamily="{StaticResource UiFont}"
                                  FontSize="{StaticResource BodySize}"
                                  Foreground="{StaticResource Text}">
                            <TextBlock Text="{loc:Str Wiz_Welcome_NoScanner}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Margin="24,4,0,0" Style="{StaticResource SmallText}"
                                   Text="{loc:Str Wiz_Welcome_NoScanner_Hint}" />

                        <Border Height="1" Background="{StaticResource BorderBrush}"
                                Margin="0,16,0,16" />

                        <TextBlock Text="{loc:Str Wiz_Welcome_HowFar}"
                                   Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,8" Style="{StaticResource SmallText}"
                                   Text="{loc:Str Wiz_Welcome_HowFar_Hint}" />

                        <Slider Minimum="1" Maximum="5" TickFrequency="1"
                                IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                Value="{Binding SafetyLevel}" />

                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SmallText}">
                            <Run Text="{loc:Str Wiz_Welcome_Chosen}" />
                            <Run Text="{Binding SafetyLevel, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{loc:Str Wiz_Welcome_OutOf}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Wiz_Welcome_HowLong}" Style="{StaticResource HeadingText}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyText}"
                                   Text="{loc:Str Wiz_Welcome_HowLong_Hint}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
