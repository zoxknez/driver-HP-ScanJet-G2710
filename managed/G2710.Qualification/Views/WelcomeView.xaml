<UserControl x:Class="G2710.Qualification.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PageMargin}">
        <!--
            Dve kolone: objasnjenje i podesavanja. Prozor je sirok, pa jedna
            kolona teksta ostavlja pola ekrana praznog.
        -->
        <Grid MaxWidth="980" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- ===== sta ce se desiti ===== -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sta ce program uraditi"
                                   Style="{StaticResource HeadingText}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="1."
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       Margin="0,0,10,0" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                       Style="{StaticResource BodyText}"
                                       Text="Prepoznaje skener i cita njegove postavke. Nista se ne pomera." />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="2."
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       Margin="0,0,10,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                       Style="{StaticResource BodyText}"
                                       Text="Pali lampu i proverava da li se to vidi u postavkama." />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="3."
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       Margin="0,0,10,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                                       Style="{StaticResource BodyText}"
                                       Text="Pravi nekoliko probnih snimaka, u vise rezolucija." />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="4."
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       Margin="0,0,10,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Style="{StaticResource BodyText}"
                                       Text="Postavlja dva pitanja na koja racunar ne moze da odgovori." />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Background="{StaticResource SurfaceSunken}">
                    <StackPanel>
                        <TextBlock Text="Pre nego sto pocnete"
                                   Style="{StaticResource HeadingText}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyText}"
                                   Text="Skener treba da bude uključen i povezan USB kablom. Poklopac zatvorite, a staklo ostavite prazno - probni snimci koriste kalibracione trake na ivici stakla." />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}"
                                   Text="Program ne menja nista na racunaru i ne instalira drajver. Ako nesto ne prodje, to ce pisati u izvestaju - skener zbog toga nece biti ostecen." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== podesavanja ===== -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Podesavanja" Style="{StaticResource HeadingText}" />

                        <CheckBox Margin="0,14,0,0" IsChecked="{Binding UseSimulator}"
                                  FontFamily="{StaticResource UiFont}"
                                  FontSize="{StaticResource BodySize}"
                                  Foreground="{StaticResource Text}">
                            <TextBlock Text="Proba bez skenera" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Margin="24,4,0,0" Style="{StaticResource SmallText}"
                                   Text="Pokrece iste provere nad simulatorom. Sluzi da se program isproba pre nego sto se posalje." />

                        <Border Height="1" Background="{StaticResource BorderBrush}"
                                Margin="0,16,0,16" />

                        <TextBlock Text="Dokle sme da ide"
                                   Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,8" Style="{StaticResource SmallText}"
                                   Text="Vise znaci temeljnije. Paket moze imati i nizi plafon, i tada se visi nivoi preskacu - to nije greska." />

                        <Slider Minimum="1" Maximum="5" TickFrequency="1"
                                IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                Value="{Binding SafetyLevel}" />

                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SmallText}">
                            <Run Text="Izabrano:" />
                            <Run Text="{Binding SafetyLevel, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="od 5" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Koliko traje" Style="{StaticResource HeadingText}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyText}"
                                   Text="Manje od minuta. Provera se moze prekinuti u svakom trenutku, i skener tada ostaje u ispravnom stanju." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
