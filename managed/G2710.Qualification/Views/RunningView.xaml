<UserControl x:Class="G2710.Qualification.Views.RunningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="{StaticResource PageMargin}">
        <!--
            Tri stanja na istom mestu: radi se, palo je, ili je gotovo pa se
            samo prelazi dalje. Svako ima svoj prikaz - prazan ekran dok se
            ceka je najcesci nacin da alat izgleda pokvareno.
        -->

        <!-- ===== radi se ===== -->
        <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StatusLine}"
                                   Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SmallText}"
                                   VerticalAlignment="Center">
                            <!--
                                Mode=OneWay NIJE suvisno: Run.Text se u WPF-u
                                vezuje DVOSMERNO po podrazumevanom, za razliku
                                od TextBlock.Text. Bez toga prozor pada pri
                                otvaranju, jer Progress ima privatan setter.
                            -->
                            <Run Text="{Binding Progress, Mode=OneWay,
                                                StringFormat={}{0:0}}" />
                            <Run Text="%" />
                        </TextBlock>
                    </Grid>

                    <ProgressBar Style="{StaticResource Progress}" Margin="0,12,0,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}" />

                    <TextBlock Margin="0,12,0,0" Style="{StaticResource SmallText}"
                               Text="Skener se ispituje. Ne iskljucujte kabl dok ovo traje." />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sta alat radi"
                               Style="{StaticResource BodyText}" FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <Border Grid.Row="1" Background="{StaticResource SurfaceSunken}"
                            CornerRadius="6" Padding="12">
                        <Grid>
                            <!-- prazno stanje: dok jos nista nije ispisano -->
                            <TextBlock Text="Cekam prvi odgovor skenera..."
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource SmallText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Log.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Log}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Style="{StaticResource MonoText}"
                                                       TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== nesto je poslo naopako ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisible}}">
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Fail}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                Background="{StaticResource FailSoft}" VerticalAlignment="Top">
                            <TextBlock Text="!" FontFamily="{StaticResource UiFont}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource Fail}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{Binding ErrorTitle}"
                                       Style="{StaticResource HeadingText}" />
                            <TextBlock Text="{Binding ErrorDetail}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="46,18,0,0">
                        <Button Content="Pokusaj ponovo"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding RetryCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ===== gotovo, ali prazno ===== -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <TextBlock Text="Alat nije prijavio nijednu proveru"
                           Style="{StaticResource HeadingText}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyText}"
                           Text="Program je zavrsio bez greske, ali izvestaj je prazan. To obicno znaci da verzija alata ne odgovara verziji ovog programa." />
                <Button Content="Pokusaj ponovo" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RetryCommand}"
                        HorizontalAlignment="Left" Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
