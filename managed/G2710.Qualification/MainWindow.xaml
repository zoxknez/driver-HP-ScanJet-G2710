<Window x:Class="G2710.Qualification.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:G2710.Qualification.Views"
        Title="HP ScanJet G2710 - provera"
        Height="720" Width="1080"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceSunken}">

    <!--
        Raspored: bocna traka fiksne sirine, sadrzaj `*`.

        Sadrzaj uzima SVU preostalu sirinu i unutar sebe je opet Grid sa `*`
        kolonama. Bez toga se sve skupi uz levu ivicu, a desna polovina prozora
        ostane prazna - najcesci nacin da alat izgleda nedovrseno.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== bocna traka ===== -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}">
            <Grid Margin="24,28,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="HP ScanJet G2710"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextOnDark}" />
                    <TextBlock Text="Provera skenera"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="{StaticResource SmallSize}"
                               Foreground="{StaticResource TextOnDarkMuted}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Height="1" Background="#FF33404D" Margin="0,20,0,20" />

                <StackPanel Grid.Row="2">
                    <views:StepIndicator Number="1" Title="Pocetak"
                                         Description="Sta ce se proveriti"
                                         IsActive="{Binding IsWelcome}"
                                         IsDone="{Binding Step1Done}" />
                    <views:StepIndicator Number="2" Title="Provera"
                                         Description="Skener se ispituje"
                                         IsActive="{Binding IsRunning}"
                                         IsDone="{Binding Step2Done}" />
                    <views:StepIndicator Number="3" Title="Pitanja"
                                         Description="Pogledajte skener"
                                         IsActive="{Binding IsQuestions}"
                                         IsDone="{Binding Step3Done}" />
                    <views:StepIndicator Number="4" Title="Izvestaj"
                                         Description="Sacuvajte i posaljite"
                                         IsActive="{Binding IsResults}"
                                         IsDone="False" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="{Binding DeviceLabel}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="{StaticResource SmallSize}"
                               Foreground="{StaticResource TextOnDarkMuted}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Verzija 1.0"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="{StaticResource SmallSize}"
                               Foreground="#FF66727F"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== sadrzaj ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- zaglavlje -->
            <Border Grid.Row="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="32,24,32,20">
                <StackPanel>
                    <TextBlock Text="{Binding StepTitle}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{Binding StepSubtitle}" Style="{StaticResource MutedText}"
                               MaxWidth="760" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ekran koraka -->
            <Grid Grid.Row="1">
                <views:WelcomeView Visibility="{Binding IsWelcome,
                                                Converter={StaticResource BoolToVisible}}" />
                <views:RunningView Visibility="{Binding IsRunning,
                                                Converter={StaticResource BoolToVisible}}" />
                <views:QuestionsView Visibility="{Binding IsQuestions,
                                                  Converter={StaticResource BoolToVisible}}" />
                <views:ResultsView Visibility="{Binding IsResults,
                                                Converter={StaticResource BoolToVisible}}" />
            </Grid>

            <!-- podnozje: dugmad su UVEK na istom mestu -->
            <Border Grid.Row="2" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="32,16,32,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Nazad"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BackCommand}" />

                    <TextBlock Grid.Column="1" Text="{Binding StatusLine}"
                               Style="{StaticResource SmallText}"
                               VerticalAlignment="Center"
                               Margin="16,0,16,0" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Prekini"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsBusy,
                                             Converter={StaticResource BoolToVisible}}"
                                Margin="0,0,12,0" />

                        <Button Content="Zapocni proveru"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding NextCommand}"
                                Visibility="{Binding IsWelcome,
                                             Converter={StaticResource BoolToVisible}}" />

                        <Button Content="Dalje"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding NextCommand}"
                                Visibility="{Binding IsQuestions,
                                             Converter={StaticResource BoolToVisible}}" />

                        <Button Content="Sacuvaj izvestaj"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveReportCommand}"
                                Visibility="{Binding IsResults,
                                             Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
